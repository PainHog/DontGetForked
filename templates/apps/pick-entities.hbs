<div class="dont-get-forked dgf-dialog dgf-pick-entities">
  <p>{{intro}}</p>
  {{#each entities}}<label class="dgf-check"><input type="checkbox" name="entity.{{id}}"{{#if checked}} checked{{/if}}> {{name}}</label>{{/each}}
  {{#unless entities.length}}<p class="dgf-hint">{{localize "DGF.Raid.noEntities"}}</p>{{/unless}}
  <label>{{placeLabel}} <input type="text" name="place" placeholder="{{placeHint}}"></label>
  {{#if already}}<p class="dgf-hint">{{already}}</p>{{/if}}
</div>
