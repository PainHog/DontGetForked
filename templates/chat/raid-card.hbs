<div class="dont-get-forked dgf-card dgf-card-raid{{#if hunt}} dgf-card-hunt{{/if}}">
  <header class="dgf-card-head"><h3>{{headline}}</h3></header>
  <p>{{text}}</p>
  {{#if essentialsLine}}<p class="dgf-card-meta">{{essentialsLine}}</p>{{/if}}
  {{#if items.length}}<ul class="dgf-list">{{#each items}}<li>{{name}}{{#if note}} <span class="dgf-card-note">({{note}})</span>{{/if}}</li>{{/each}}</ul>{{/if}}
  {{#if left}}<p class="dgf-card-caught">{{left}}</p>{{/if}}
  {{#if piece}}<p class="dgf-card-meta">{{piece}}</p>{{/if}}
  {{#if passed}}<p class="dgf-card-meta">{{passed}}</p>{{/if}}
  {{#if spectralRolls}}<p class="dgf-card-meta">{{spectralRolls}}</p>{{/if}}
  {{#if castle}}<p>{{castle}}</p>{{/if}}
  {{#if extras}}<p class="dgf-card-meta">{{extras}}</p>{{/if}}
  <div class="dgf-card-actions"></div>
</div>
