<div class="dgf-hud-body{{#if hunt}} dgf-hunting{{/if}}">
  <div class="dgf-hud-row dgf-hud-suspicion">
    <span class="dgf-hud-label">{{localize "DGF.Suspicion"}}</span>
    <span class="dgf-hud-value" data-value="{{value}}" data-limit="{{limit}}">{{value}} / {{limit}}</span>
  </div>
  <div class="dgf-pips">{{#each pips}}<span class="dgf-pip{{#if filled}} dgf-filled{{/if}}"></span>{{/each}}</div>
  <div class="dgf-hud-row"><span class="dgf-hud-turn">{{turnLine}}</span><span class="dgf-hud-diff">{{label}}</span></div>
  {{#if atLimit}}{{#unless hunt}}<p class="dgf-hud-alert">{{localize "DGF.Raid.atLimit"}}</p>{{/unless}}{{/if}}
  {{#if hunt}}<p class="dgf-hud-alert dgf-hud-hunt">{{huntLine}}</p>{{/if}}
  {{#if over}}<p class="dgf-hud-alert dgf-hud-over">{{over}}</p>{{/if}}
  {{#if partyOut}}<p class="dgf-hud-alert dgf-hud-over">{{localize "DGF.Raid.partyOut"}}{{#if isGM}} <button type="button" class="dgf-link" data-action="backInTown" data-tooltip="{{localize "DGF.Raid.backInTownHint"}}">{{localize "DGF.Raid.backInTown"}}</button>{{/if}}</p>{{/if}}
  {{#if chase}}<p class="dgf-hud-chase"><button type="button" class="dgf-link" data-action="openChase">{{chase}}</button></p>{{/if}}
  {{#if group}}<p class="dgf-hud-group">{{localize "DGF.Raid.groupOpen" label=group.label}}{{#if group.waiting}} — {{localize "DGF.Raid.groupWaiting" names=group.waiting}}{{/if}}{{#if isGM}} <button type="button" class="dgf-link" data-action="closeGroup">{{localize "DGF.Raid.closeGroup"}}</button>{{/if}}</p>{{/if}}
  {{#if captives.length}}
  <div class="dgf-hud-lockup">
    <span class="dgf-hud-label">{{localize "DGF.Raid.lockup" difficulty=lockup}}</span>
    <ul>{{#each captives}}<li data-actor-id="{{actorId}}">{{name}}{{#if since}} <span class="dgf-hint">{{since}}</span>{{/if}}{{#if ../isGM}} <button type="button" class="dgf-link" data-action="freeCaptive" data-actor-id="{{actorId}}">{{localize "DGF.Raid.free"}}</button>{{/if}}</li>{{/each}}</ul>
  </div>
  {{/if}}
  {{#if furnitureLost}}<p class="dgf-hud-group">{{localize "DGF.Raid.furnitureLost"}}</p>{{/if}}
  {{#if furnitureOut}}<p class="dgf-hud-group">{{localize "DGF.Raid.furnitureOut"}}</p>{{/if}}
  {{#if furnitureInPlay}}<p class="dgf-hud-group">{{localize "DGF.Raid.furnitureInPlay"}}{{#if isGM}} <button type="button" class="dgf-link" data-action="furnitureOut">{{localize "DGF.Raid.furnitureOutButton"}}</button> <button type="button" class="dgf-link" data-action="furnitureLost">{{localize "DGF.Raid.furnitureLostButton"}}</button>{{/if}}</p>{{/if}}
  {{#if list.length}}
  <details class="dgf-hud-list"><summary>{{localize "DGF.Raid.listCount" n=list.length}}</summary>
    <ul>{{#each list}}<li>{{name}}{{#if essential}} <em>({{localize "DGF.List.essential"}})</em>{{/if}}</li>{{/each}}</ul>
  </details>
  {{/if}}
  {{#if isGM}}
  <div class="dgf-hud-controls">
    <button type="button" data-action="suspicionUp" data-tooltip="{{localize "DGF.Raid.up"}}">+1</button>
    <button type="button" data-action="suspicionDown" data-tooltip="{{localize "DGF.Raid.down"}}">−1</button>
    <button type="button" data-action="undo">{{localize "DGF.Raid.undo"}}</button>
  </div>
  <div class="dgf-hud-controls">
    <button type="button" data-action="prevTurn">◀ {{localize "DGF.Raid.turnShort"}}</button>
    <button type="button" data-action="nextTurn">{{localize "DGF.Raid.nextTurn"}} ▶</button>
    <button type="button" data-action="toggleHunt">{{#if hunt}}{{localize "DGF.Raid.stopHunt"}}{{else}}{{localize "DGF.Raid.startHunt"}}{{/if}}</button>
  </div>
  {{#if hasEvents}}
  <ol class="dgf-hud-events">
    {{#each events}}
    <li class="dgf-ev{{#if cancelled}} dgf-cancelled{{/if}}" data-event-id="{{eventId}}">
      <span class="dgf-ev-amount">{{amount}}</span>
      <span class="dgf-ev-text">{{localize "DGF.Raid.turnOf" turn=turn}} · {{text}}</span>
      {{#if cancelled}}<button type="button" data-action="restoreEvent" data-event-id="{{eventId}}">{{localize "DGF.Raid.restore"}}</button>{{else}}<button type="button" data-action="cancelEvent" data-event-id="{{eventId}}">{{localize "DGF.Raid.cancel"}}</button>{{/if}}
    </li>
    {{/each}}
  </ol>
  {{/if}}
  <div class="dgf-hud-controls dgf-wrap">
    {{#if groupsOn}}<button type="button" data-action="groupCheck">{{localize "DGF.Raid.groupCheck"}}</button>{{/if}}
    <button type="button" data-action="tellCheck">{{localize "DGF.Raid.tellCheck"}}</button>
    <button type="button" data-action="openChase">{{localize "DGF.Raid.chase"}}</button>
  </div>
  <div class="dgf-hud-controls dgf-wrap">
    <button type="button" data-action="shoppingList">{{localize "DGF.Raid.list"}}</button>
    <button type="button" data-action="endRaid">{{localize "DGF.Raid.endRaid"}}</button>
    <button type="button" data-action="newRaid">{{localize "DGF.Raid.newRaid"}}</button>
  </div>
  {{/if}}
</div>
