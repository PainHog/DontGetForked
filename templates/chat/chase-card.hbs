<div class="dont-get-forked dgf-card dgf-card-chase{{#if final}} dgf-card-final{{/if}}{{#if outcomeClass}} dgf-outcome-{{outcomeClass}}{{/if}}">
  <header class="dgf-card-head"><h3>{{headline}}</h3></header>
  {{#if who}}<p>{{who}}</p>{{/if}}
  {{#if start}}<p class="dgf-card-meta">{{start}}</p>{{/if}}
  {{#if ground}}<p class="dgf-chase-ground"><strong>{{ground}}</strong>{{#if groundText}} <em>{{groundText}}</em>{{/if}}</p>{{/if}}
  {{#each extras}}<p class="dgf-card-note">{{this}}</p>{{/each}}
  {{#if mob}}<p>{{mob}}</p>{{/if}}
  {{#if weak}}<p class="dgf-card-monster">{{weak}}</p>{{/if}}
  {{#if rolls.length}}<ul class="dgf-chase-rolls">{{#each rolls}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  {{#if move}}<p class="dgf-chase-move">{{move}}</p>{{/if}}
  {{#if outcome}}<p class="dgf-chase-outcome">{{outcome}}</p>{{/if}}
  {{#each fates}}<p class="dgf-card-caught">{{this}}</p>{{/each}}
  <div class="dgf-card-actions"></div>
</div>
